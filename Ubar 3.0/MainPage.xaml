<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Ubar3.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Ubar3"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Shared style for module host containers -->
        <Style x:Key="ModuleHostStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Spacing" Value="6" />
        </Style>
        <!-- Bar context flyout - defined here so it can be referenced from code -->
        <MenuFlyout x:Key="BarContextFlyout" x:Name="BarContextFlyout" />
    </Page.Resources>

<Grid Background="Transparent">
        <!-- Main Top Bar Layout -->
        <Grid
            x:Name="RootBar"
            Height="60"
            BorderBrush="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
            BorderThickness="0,0,0,1"
            Padding="20,0,20,0"
            Background="Transparent"
            RightTapped="RootBar_RightTapped">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT SLOT -->
            <StackPanel
                x:Name="LeftSlot"
                Grid.Column="0"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Spacing="16" />

            <!-- CENTER SLOT -->
            <StackPanel
                x:Name="CenterSlot"
                Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Spacing="8" />

            <!-- RIGHT SLOT -->
            <StackPanel
                x:Name="RightSlot"
                Grid.Column="2"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Spacing="16" />
        </Grid>
    </Grid>
</Page>


